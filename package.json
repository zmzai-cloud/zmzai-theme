{
  "name": "@zmzai/theme",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "description": "zmzai 全品牌设计系统 — Radix UI + framer-motion + Tailwind v4 + MiSans",
  "license": "Apache-2.0",
  "author": "知末智云 <mifindxuan@gmail.com>",
  "homepage": "https://github.com/zmzai-cloud/zmzai-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmzai-cloud/zmzai-theme.git"
  },
  "bugs": {
    "url": "https://github.com/zmzai-cloud/zmzai-theme/issues"
  },
  "keywords": [
    "zmzai",
    "design-system",
    "radix-ui",
    "tailwindcss",
    "framer-motion",
    "react",
    "components"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens": "./src/tokens/theme.css",
    "./fonts": "./src/tokens/fonts.css",
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*/index.ts",
      "import": "./src/components/*/index.ts"
    },
    "./brand": {
      "types": "./src/brand/index.ts",
      "import": "./src/brand/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "playground": "vite playground --port 5174",
    "prepublishOnly": "pnpm typecheck"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^11.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.0"
  }
}
